# See docs/configuration.md for more information.

# Necessary API Keys
# -------------------

# TikTok Session ID
# Obtain your session ID by logging into TikTok and copying the sessionid cookie.
TIKTOK_SESSION_ID=""

# ImageMagick Binary Path
# Download ImageMagick from https://imagemagick.org/script/download.php
# Leave empty to auto-detect from PATH.
IMAGEMAGICK_BINARY=""

# Pexels API Key
# Register at https://www.pexels.com/api/ to get your API key.
PEXELS_API_KEY=""

# Optional API Keys
# -----------------

# Under docker compose these three are set by docker-compose.yml and any value here is ignored:
#   OLLAMA_BASE_URL, DATABASE_URL, IMAGEMAGICK_BINARY

# Ollama API Base URL
# Local default: http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama Model
# Fallback model if frontend did not send a value.
# Pull a model first: ollama pull llama3.1:8b
OLLAMA_MODEL="llama3.1:8b"

# Seconds to wait for one Ollama response. Empty = 180.
OLLAMA_TIMEOUT=""

# ElevenLabs API key. Empty keeps every format on the free TikTok voice.
# Only long form uses it; see "Narration" in docs/configuration.md.
# Restrict the key to Text to Speech and give it a monthly credit cap: it is
# used unattended by the autopilot.
ELEVENLABS_API_KEY=""

# AssemblyAI API Key
# Sign up at https://www.assemblyai.com/ to receive an API key.
ASSEMBLY_AI_API_KEY=""

# Database
# Leave DATABASE_URL empty for local SQLite default.
POSTGRES_DB="moneyprinter"
POSTGRES_USER="moneyprinter"
POSTGRES_PASSWORD="moneyprinter"
DATABASE_URL=""

# Browser origins allowed to call the API (comma-separated). Empty = the local UI on
# ports 8001 (Docker frontend) and 3000 (python -m http.server), via localhost and 127.0.0.1.
CORS_ORIGINS=""

# YouTube upload
# Privacy of uploaded videos: private | unlisted | public (locked to private until the API compliance audit passes)
YOUTUBE_PRIVACY_STATUS="private"
# YouTube category id, 28 = Science & Technology
YOUTUBE_CATEGORY_ID="28"

# Paths to the OAuth client and token files. Empty = Backend/client_secret.json
# and Backend/youtube_token.json. docker-compose.yml points them at /app/secrets/.
YOUTUBE_CLIENT_SECRETS_FILE=""
YOUTUBE_TOKEN_FILE=""

# Autopilot (Backend/autopilot.py)
# false pauses job creation; notifications keep working.
AUTOPILOT_ENABLED="true"
# Channel niche in free text. Required when AUTOPILOT_ENABLED=true.
AUTOPILOT_NICHE=""
# Jobs per day, 1..6. Each upload costs 1600 of the 10000 daily YouTube API units.
AUTOPILOT_VIDEOS_PER_DAY="2"
# Local-time window (TZ) in which jobs are created, HH:MM-HH:MM within one day.
AUTOPILOT_WINDOW="09:00-21:00"
# Model for topics and scripts; empty uses OLLAMA_MODEL.
AUTOPILOT_MODEL=""
AUTOPILOT_VOICE="en_us_001"
AUTOPILOT_PARAGRAPHS="1"
AUTOPILOT_SUBTITLES_POSITION="center,center"
AUTOPILOT_COLOR="#FFFF00"
AUTOPILOT_USE_MUSIC="false"
AUTOPILOT_CUSTOM_PROMPT=""
# Long videos per week, 0..7. 0 keeps the autopilot on Shorts only.
# Each long video costs ElevenLabs credits and takes several times as long to
# render, so raise this only once there are credits to spend.
AUTOPILOT_LONGFORM_PER_WEEK="0"

# Days to keep output/<job_id>.mp4 files.
OUTPUT_RETENTION_DAYS="7"
# Telegram notifications; leave empty to log only.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Timezone for the window and the daily counter.
TZ="UTC"
